# Copy this file to oracle.env and fill the values before running scripts.
# Keep oracle.env private. It contains server addresses and secrets.

# OCI instances.
ORACLE_APP_HOST=
ORACLE_DB_HOST=
ORACLE_APP_PRIVATE_IP=
ORACLE_DB_PRIVATE_IP=

# Oracle Linux images usually use "opc"; Ubuntu images usually use "ubuntu".
ORACLE_APP_SSH_USER=opc
ORACLE_DB_SSH_USER=opc

# SSH private keys downloaded from OCI.
ORACLE_APP_SSH_KEY=keys_pub/ssh-key-sub2api-server.key
ORACLE_DB_SSH_KEY=keys_pub/ssh-key-sub2api-db.key

# Remote deploy directory on both instances.
ORACLE_REMOTE_DIR=/opt/sub2api

# Local image build output.
SUB2API_IMAGE=sub2api:oracle-amd64
SUB2API_PLATFORM=linux/amd64
SUB2API_IMAGE_ARCHIVE=deploy/oracle-free-tier/artifacts/sub2api-oracle-amd64.tar.gz

# App service.
SERVER_PORT=8080
SERVER_BIND_HOST=127.0.0.1
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai
ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=

# HTTPS reverse proxy. Use a hostname that points to ORACLE_APP_HOST.
CADDY_DOMAIN=
CADDY_EMAIL=admin@sub2api.local
CADDY_UPSTREAM=127.0.0.1:8080

# Generate these with: openssl rand -hex 32
JWT_SECRET=
TOTP_ENCRYPTION_KEY=

# Database.
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=
POSTGRES_DB=sub2api
DATABASE_MAX_OPEN_CONNS=6
DATABASE_MAX_IDLE_CONNS=2

# Redis.
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=2

# Keep memory conservative on 1 GB instances.
ORACLE_SWAP_SIZE_GB=4
APP_GOMEMLIMIT=512MiB
APP_GOGC=80
POSTGRES_MAX_CONNECTIONS=40
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_EFFECTIVE_CACHE_SIZE=512MB
POSTGRES_MAINTENANCE_WORK_MEM=32MB
POSTGRES_WORK_MEM=2MB
REDIS_MAXMEMORY=128mb
REDIS_MAXCLIENTS=128

# Optional build mirrors.
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn
